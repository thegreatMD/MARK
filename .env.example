# before the assistant opens the microphone, camera, screen capture, clipboard,
# browser automation, or desktop automation. Default: true.
ASK_PERMISSION_BEFORE_USE=true

# Optional autonomy + allowlist (described in README)
# AUTONOMY_LEVEL=manual
# ALLOWLIST=create_proposal,send_email,browser_fill
