{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Auto Start Mark (Watch Mode)",
            "type": "shell",
            "command": "start_mark.bat",
            "windows": {
                "command": "start_mark.bat",
                "options": {
                    "shell": {
                        "executable": "cmd.exe",
                        "args": ["/d", "/c"]
                    }
                }
            },
            "runOptions": {
                "runOn": "folderOpen"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": false
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}