{
  "manifest_version": 3,
  "name": "Mark — Web Companion",
  "version": "1.0.0",
  "description": "Ask Mark about the page you are viewing.",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:8080/*", "http://127.0.0.1:8080/*"],
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }],
  "background": {"service_worker": "background.js", "type": "module"},
  "commands": {"toggle-mark": {"suggested_key": {"default": "Alt+M", "mac": "Command+M"}, "description": "Open or close Mark"}},
  "action": {"default_title": "Open Mark"},
  "options_page": "options.html"
}
